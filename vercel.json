{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
      "app": {
        "architecture": "x86_64",
        "runtime": "@vercel/do-not-use",
        "framework": "Laravel"
      }
    },
    "build": {
      "app": {
        "entrypoint": "Dockerfile.vercel"
      }
    },
    "routes": [
      { "src": "/(.*)", "dest": "/app/public/$1" }
    ]
  }